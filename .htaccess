# Exibe mensagem de erro customizada
ErrorDocument 403 "Error 403: Sem permissao para acessar este diretorio."

# Desativa a listagem de arquivos das pastas
Options -Indexes

# Bloqueia acesso direto ao .env
<Files .env>
    Require all denied
</Files>

# Bloqueia arquivos de configuracao e logs
<FilesMatch "\.(json|lock|log|ini|env)$">
    Require all denied
</FilesMatch>

# Bloqueia acesso via URL nas pastas
RedirectMatch 403 ^/vendor(/.*)?$